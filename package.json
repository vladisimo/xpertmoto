{
  "name": "xpertmoto",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "analyze": "ANALYZE=true next build",
    "lhci": "lhci autorun",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:local": "npm run db:reset:e2e && E2E_DB=1 PORT=3137 E2E_NO_RESEED=1 playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/public-pages.spec.ts --project=public",
    "test:e2e:critical": "playwright test tests/e2e/public/route-sweep.spec.ts tests/e2e/customer/route-sweep.spec.ts tests/e2e/staff/route-sweep.spec.ts tests/e2e/admin/route-sweep.spec.ts tests/e2e/auth-and-portal.spec.ts tests/e2e/booking/wizard-stub.spec.ts",
    "test:e2e:concurrency": "playwright test tests/e2e/concurrency",
    "test:e2e:stripe": "npm run db:reset:e2e && E2E_DB=1 PORT=3137 E2E_NO_RESEED=1 playwright test tests/e2e/booking/payment-stripe.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "worker": "tsx src/server/jobs/worker.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed-snapshot.ts",
    "db:seed:demo": "tsx prisma/seed.ts",
    "db:seed:minimal": "tsx prisma/seed-minimal.ts",
    "db:snapshot": "bash scripts/db-snapshot.sh",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed-snapshot.ts",
    "db:reset:demo": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "db:reset:minimal": "prisma migrate reset --force --skip-seed && tsx prisma/seed-minimal.ts",
    "db:reset:e2e": "node --env-file=.env.e2e node_modules/prisma/build/index.js migrate reset --force --skip-seed && node --env-file=.env.e2e --import tsx prisma/seed.ts && node scripts/flush-e2e-cache.mjs",
    "dev:e2e": "node scripts/dev-e2e.mjs",
    "db:clear-bookings": "tsx scripts/clear-bookings.ts",
    "db:gps51-telemetry-reset": "tsx scripts/gps51-telemetry-reset.ts",
    "db:gps51-speed-units-backfill": "tsx scripts/backfill-telemetry-speed-units.ts",
    "db:studio": "prisma studio",
    "db:slow": "tsx scripts/db-slow.ts",
    "chaos:stripe-flake": "tsx scripts/chaos/stripe-flake.ts",
    "chaos:db-partition": "tsx scripts/chaos/db-partition.ts",
    "load:booking-surge": "k6 run scripts/load/booking-surge.js",
    "load:toll-ingest": "k6 run scripts/load/toll-ingest.js",
    "import:fleet": "tsx scripts/import-fleet-from-csv.ts",
    "scrape:xpertmoto": "tsx scripts/scrape-xpertmoto.ts",
    "import:xpertmoto-rates": "tsx scripts/import-xpertmoto-rates.ts",
    "merge:xpertmoto-models": "tsx scripts/merge-xpertmoto-models.ts",
    "import:drivers": "tsx scripts/import-drivers-from-csv.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@auth/prisma-adapter": "^2.11.3",
