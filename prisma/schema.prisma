// ============================================================================
// SUPPORT CHATBOT MODELS
// ============================================================================

// A conversation thread between a customer (or guest) and the support
// system. Starts on widget open; persists whether the interaction
// produced a ticket or was resolved entirely by the AI.
model SupportConversation {
  id                   String              @id @default(cuid())
  source               SupportSource       @default(WIDGET)
  customerId           String?
  customer             User?               @relation(fields: [customerId], references: [id])
  guestName            String?
  guestEmail           String?
  guestPhone           String?
  depotId              String?
  depot                Depot?              @relation(fields: [depotId], references: [id])
  bookingId            String?
  booking              Booking?            @relation(fields: [bookingId], references: [id])
  aiEnabled            Boolean             @default(true)
  lastMessageAt        DateTime            @default(now())
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  // Finalised by the visitor-session-finalise pass once the conversation
  // has been quiet for ≥72h. Drives the Sales Performance leaderboard.
  firstStaffResponseAt DateTime?
  firstResponseSeconds Int?
  interactionOutcome   InteractionOutcome?
  attributedBookingId  String?
  attributedBooking    Booking?            @relation("SupportConvAttributedBooking", fields: [attributedBookingId], references: [id], onDelete: SetNull)

  messages SupportMessage[]
  ticket   SupportTicket?
  feedback SupportFeedback[]
  costLogs SupportCostLog[]
  visitor  VisitorSession?

  @@index([customerId, lastMessageAt])
  @@index([depotId, lastMessageAt])
  @@index([source, lastMessageAt])
  @@index([bookingId])
  @@index([firstStaffResponseAt])
  @@index([attributedBookingId])
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderRole     SupportSenderRole
  senderUserId   String?
  body           String              @db.Text
  toolCalls      Json?
  attachments    Json?
  isInternalNote Boolean             @default(false)
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}

model SupportTicket {
  id               String              @id @default(cuid())
  ticketNumber     String              @unique
  conversationId   String              @unique
  conversation     SupportConversation @relation(fields: [conversationId], references: [id])
  category         SupportCategory
  priority         SupportPriority     @default(NORMAL)
  status           SupportTicketStatus @default(OPEN)
  depotId          String?
  depot            Depot?              @relation(fields: [depotId], references: [id])
  assigneeId       String?
  assignee         User?               @relation("SupportTicketAssignee", fields: [assigneeId], references: [id])
  customerId       String?
  customer         User?               @relation("SupportTicketCustomer", fields: [customerId], references: [id])
  linkedBookingId  String?
  linkedBooking    Booking?            @relation(fields: [linkedBookingId], references: [id])
  linkedIncidentId String?
  linkedIncident   Incident?           @relation(fields: [linkedIncidentId], references: [id])
  summary          String
  description      String              @db.Text
  firstResponseAt  DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  notes    SupportTicketNote[]
  feedback SupportFeedback[]

  @@index([status, priority, depotId])
  @@index([assigneeId, status])
  @@index([customerId, createdAt])
  @@index([depotId])
  @@index([linkedBookingId])
  @@index([linkedIncidentId])
}

model SupportTicketNote {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  body       String        @db.Text
  isInternal Boolean       @default(true)
  createdAt  DateTime      @default(now())

  @@index([ticketId])
  @@index([userId])
}

model SupportFeedback {
  id             String              @id @default(cuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ticketId       String?
  ticket         SupportTicket?      @relation(fields: [ticketId], references: [id])
  rating         Int
  kind           SupportFeedbackKind
  comment        String?             @db.Text
  createdAt      DateTime            @default(now())

  @@unique([conversationId, kind])
  @@index([ticketId])
  @@index([createdAt, kind])
}

model SupportCostLog {
  id                  String              @id @default(cuid())
  conversationId      String
  conversation        SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  provider            String
  model               String
  inputTokens         Int
  outputTokens        Int
  cachedInputTokens   Int                 @default(0)
  cacheCreationTokens Int                 @default(0)
  costAud             Decimal             @db.Decimal(10, 6)
  createdAt           DateTime            @default(now())

  @@index([createdAt])
  @@index([conversationId])
  @@index([provider, createdAt])
}

// ============================================================================
// LIVE VISITOR PRESENCE
// ============================================================================

// Outcome assigned by the visitor-session-finalise pass of the cleanup job.
// BOUNCED: single page view <15s. ABANDONED_WIZARD: reached wizardStep ≥1
// with no booking in 72h. CONVERTED: booking within 72h of lastSeenAt and
// wizardHighestStep ≥1. LEFT: multi-page but no wizard engagement.
enum VisitorOutcome {
  BOUNCED
  ABANDONED_WIZARD
  CONVERTED
  LEFT
}

enum VisitorDeviceType {
  MOBILE
  TABLET
  DESKTOP
  BOT
}

// Outcome for a staff-to-visitor support interaction — assigned by the
// finalise pass after 72h of inactivity on the conversation.
enum InteractionOutcome {
  CONVERTED
  NO_RESPONSE
  ABANDONED
  IN_PROGRESS
  RESOLVED
}

// Cookie-keyed presence row for public-site visitors. Populated by the
// `live.heartbeat` tRPC mutation every ~20s. `conversationId` is set once
// a live chat begins (staff-initiated via `startChatWithVisitor` or
// visitor-initiated via `visitorOpenChat`). Orphan rows (no conversation)
// are pruned by the `visitor-session-cleanup` BullMQ job.
//
// Analytics columns (geo / referrer / utm* / deviceType / outcome etc.) are
// populated on first heartbeat and finalised by the cleanup job's finalise
// pass. Raw IP is never persisted — only SHA-256(ip + IP_HASH_SALT).
model VisitorSession {
  id                 String               @id
  userId             String?
  user               User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  currentPath        String
  wizardStep         Int?
  userAgentHash      String
  startedAt          DateTime             @default(now())
  lastSeenAt         DateTime             @default(now())
  conversationId     String?              @unique
  conversation       SupportConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  ipHash             String?
  country            String?
  region             String?
  city               String?
  referrer           String?
  landingPath        String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  deviceType         VisitorDeviceType?
  endedAt            DateTime?
  durationSeconds    Int?
  totalPageViews     Int                  @default(0)
  wizardHighestStep  Int?
  outcome            VisitorOutcome?
  convertedBookingId String?
  convertedBooking   Booking?             @relation("VisitorSessionConvertedBooking", fields: [convertedBookingId], references: [id], onDelete: SetNull)
  pageViews          VisitorPageView[]
  events             VisitorEvent[]

  // Booking-wizard snapshot captured by each heartbeat. The full shape
  // lives in `wizardState` as JSON; the five scalar columns are
  // denormalised copies kept in sync so we can run fast GROUP BY /
  // filter queries for the abandoned-cart widgets without probing JSON
  // on every row. PII (customer block, delivery address, signature) is
  // never written here — the client strips before sending.
  wizardState      Json?
  quotedTotalCents Int?
  pickupDepotId    String?
  categoryId       String?
  vehicleId        String?
  discountCode     String?

  // Retention identity — a stable cookie minted client-side on first
  // hit and persisted in `sc_visitor` for 1 year. `sessionNumber` is 1
  // on the visitor's first session, 2 on the second, etc., computed at
  // session-create time. `isReturning` is `sessionNumber > 1`, a
  // pre-computed shortcut for cohort queries. `trafficChannel`
  // classifies acquisition at create time (see `classifyChannel` in
  // src/lib/analytics/channel.ts) so queries don't need to rebuild the
  // classification on every read.
  visitorFingerprint String?
  sessionNumber      Int             @default(1)
  isReturning        Boolean         @default(false)
  trafficChannel     TrafficChannel?

  // Engagement rollup — written by the finalise pass from the session's
  // VisitorEvent rows. `maxScrollDepth` is the deepest SCROLL_DEPTH %
  // reported (0–100); `engagementScore` is a 0–100 heuristic combining
  // duration, breadth, depth, wizard progress, and event volume (see
  // `scoreEngagement` in src/lib/analytics/engagement.ts).
  maxScrollDepth  Int?
  engagementScore Int?

  @@index([lastSeenAt])
  @@index([userId])
  @@index([country, startedAt])
  @@index([outcome, startedAt])
  @@index([convertedBookingId])
  @@index([utmSource, startedAt])
  @@index([ipHash, startedAt])
  @@index([pickupDepotId, startedAt])
  @@index([categoryId, startedAt])
  @@index([vehicleId, startedAt])
  @@index([discountCode, startedAt])
  @@index([visitorFingerprint, startedAt])
  @@index([trafficChannel, startedAt])
  @@index([isReturning, startedAt])
}

enum TrafficChannel {
  DIRECT
  ORGANIC
  PAID
  SOCIAL
  EMAIL
  REFERRAL
  OTHER
}

// Append-only log of each distinct path a visitor viewed within a session.
// Written by `live.heartbeat` when the reported path changes; the previous
// row is closed (leftAt + durationMs) at that moment. Retention: pruned
// after 90 days by `runVisitorSessionCleanup`.
model VisitorPageView {
  id         String         @id @default(cuid())
  sessionId  String
  session    VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  path       String
  enteredAt  DateTime       @default(now())
  leftAt     DateTime?
  durationMs Int?
  referrer   String?

  @@index([sessionId, enteredAt])
  @@index([path, enteredAt])
}

// Append-only log of client-side tracked events (clicks, fleet views/
// clicks, search submits, discount attempts, wizard step enters).
// Written by the batched `live.events` mutation every 5s or on a
// 20-event buffer. PII is stripped client-side before enqueue; the
// `value` column never contains emails, phones, or names. Retention:
// pruned after 60 days by `runVisitorSessionCleanup`.
model VisitorEvent {
  id         String           @id @default(cuid())
  sessionId  String
  session    VisitorSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind       VisitorEventKind
  path       String
  occurredAt DateTime         @default(now())

  // Narrow payload: target is the `data-track` attribute / CSS selector
  // / form-field name; value is the sanitised scalar (search query,
  // discount code, etc); numericValue covers scroll %, duration ms,
  // click count. `metadata` is the escape hatch for event-specific
  // extras but we avoid probing it in aggregate queries.
  target       String?
  value        String?
  numericValue Int?
  metadata     Json?

  // Denormalised so the Behaviour-tab queries can filter without a
  // join back to VisitorSession on every row.
  wizardStep Int?
  deviceType VisitorDeviceType?

  @@index([sessionId, occurredAt])
  @@index([kind, occurredAt])
  @@index([path, kind, occurredAt])
}

// Staff-defined saved segment — a named combination of analytics
// filters. Loaded from the segment picker in the filter bar; applying
// a segment writes its `filter` JSON onto the URL so all analytics
// tabs see it. `filter` follows the shape of `AnalyticsFilterInput`
// on the server — validated with Zod on the write path.
model AnalyticsSegment {
  id        String   @id @default(cuid())
  name      String
  createdBy String
  creator   User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  filter    Json
  isShared  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdBy])
  @@index([isShared, createdAt])
}

// Staff-defined analytics funnel. `steps` is a typed JSON array of
// conditions evaluated in order against VisitorSession + VisitorEvent
// rows. Used by the Custom Funnels widget on the Conversion tab.
model AnalyticsFunnel {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdBy   String
  creator     User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  steps       Json
  isShared    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdBy])
  @@index([isShared, createdAt])
}

// Analytics alert rule. Evaluated every 5 minutes by the
// `analytics-alert` BullMQ job; when `metric <OPERATOR> threshold` is
// true and the cooldown has elapsed, the evaluator sends email to
// `notifyEmails` and writes `lastFiredAt`. Managers+ can CRUD.
model AnalyticsAlert {
  id              String    @id @default(cuid())
  name            String
  metric          String // analytics metric key, e.g. "bounces_last_hour"
  operator        String // ">" | "<" | ">=" | "<=" | "=="
  threshold       Float
  notifyEmails    Json // string[] — staff emails to notify
  cooldownMinutes Int       @default(60) // dedup window before re-firing
  isActive        Boolean   @default(true)
  lastFiredAt     DateTime?
  lastValue       Float? // most recent observed value, for the UI
  lastCheckedAt   DateTime?
  createdBy       String
  creator         User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive])
  @@index([createdBy])
}

enum VisitorEventKind {
  CLICK
  CTA_CLICK
  FLEET_VIEW
  FLEET_CLICK
  FORM_FIELD_FOCUS
  FORM_FIELD_CHANGE
  FORM_FIELD_BLUR
  SEARCH
  DISCOUNT_ATTEMPTED
  DISCOUNT_APPLIED
  DISCOUNT_REJECTED
  SCROLL_DEPTH
  EXIT_INTENT
  RAGE_CLICK
  DEAD_CLICK
  COPY
  CHAT_OPEN
  CHAT_MESSAGE_SENT
  WIZARD_STEP_ENTER
  WIZARD_STEP_LEAVE
  WIZARD_SNAPSHOT
  PRICE_VIEWED
  CUSTOM
}

// ============================================================================
// STAFF PRIORITY TASKS
// ============================================================================

// A persistent record of a staff member claiming a piece of actionable work.
// Virtual tasks (pickups, returns, work orders, etc.) are enumerated on-demand
// from domain state; this table only tracks *attempts* — from click-Start
// (startedAt) to either natural completion by the domain mutation
// (status=COMPLETED), supersession by another user or terminal state
// (status=SUPERSEDED), explicit abandon (status=ABANDONED), or heartbeat-based
// auto-abandon. A Postgres partial unique index on (taskType, targetEntityId)
// WHERE status='IN_PROGRESS' prevents two staff claiming the same task.

enum StaffTaskType {
  BOOKING_PICKUP
  BOOKING_RETURN
  BOOKING_OVERDUE_CHASE
  INSPECTION_PRE_HIRE
  INSPECTION_POST_HIRE
  INSPECTION_FLAGGED_REVIEW
  MAINTENANCE_WORK_ORDER
  VEHICLE_REGO_ACTION
  VEHICLE_CTP_ACTION
  VEHICLE_INSURANCE_ACTION
  VEHICLE_SERVICE_ACTION
  VEHICLE_TYRE_ACTION
  INCIDENT_TRIAGE
  INCIDENT_INVESTIGATE
  SUPPORT_TICKET_TRIAGE
  SUPPORT_TICKET_RESPOND
  CUSTOMER_LICENCE_VERIFY
  RENTAL_AGREEMENT_SIGN
  RETURN_ASSESSMENT_FINALISE
  CALENDAR_ALLOCATION
  DAMAGE_CHARGE_CONFIRM
  INFRINGEMENT_NOMINATE
  BOND_RELEASE_REVIEW
}

enum StaffTaskTier {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum StaffTaskActivityStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  SUPERSEDED
}

model StaffTaskActivity {
  id                      String                  @id @default(cuid())
  taskType                StaffTaskType
  targetEntityKind        String
  targetEntityId          String
  staffId                 String
  depotId                 String?
  tierSnapshot            StaffTaskTier
  startedAt               DateTime                @default(now())
  completedAt             DateTime?
  lastHeartbeatAt         DateTime?
  status                  StaffTaskActivityStatus @default(IN_PROGRESS)
  outcome                 String?
  outcomeNote             String?
  metadata                Json?
  // When the collector reports the task first became actionable — captured at
  // claim time so we can compute queue-wait and end-to-end cycle durations
  // in the staff history view. Nullable for pre-existing rows.
  actionableSinceSnapshot DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  staff User @relation("StaffTaskActivityStaff", fields: [staffId], references: [id])

  @@index([staffId, status])
  @@index([taskType, targetEntityId, status])
  @@index([startedAt])
  @@index([completedAt])
  @@index([status, lastHeartbeatAt])
  @@index([depotId])
}

