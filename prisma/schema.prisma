model SubscriptionPlan {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  description       String?
  categoryIds       String[]
  priceMonthlyAud   Decimal  @db.Decimal(10, 2)
  includedDays      Int?
  includedKm        Int?
