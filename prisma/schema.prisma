}

model Subscription {
  id                   String             @id @default(cuid())
  customerId           String
  businessAccountId    String?
  planId               String
  stripeSubscriptionId String?
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime           @db.Timestamptz
  currentPeriodEnd     DateTime           @db.Timestamptz
  startedAt            DateTime           @default(now()) @db.Timestamptz
  pausedAt             DateTime?          @db.Timestamptz
  pauseReason          String?
  cancelledAt          DateTime?          @db.Timestamptz
  cancelReason         String?
  usageSnapshot        Json               @default("{}")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  customer        User                @relation("SubscriptionCustomer", fields: [customerId], references: [id])
  businessAccount BusinessAccount?    @relation(fields: [businessAccountId], references: [id])
  plan            SubscriptionPlan    @relation(fields: [planId], references: [id])
  usages          SubscriptionUsage[]
