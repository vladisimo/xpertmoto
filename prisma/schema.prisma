  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([isActive, nextDueDate])
}

/// Asset-history record for depreciation + book-value calculations.
/// MUST NOT be hard-deleted — skews vehicle profitability reports.
model MaintenanceWorkOrder {
  id                    String            @id @default(cuid())
  workOrderNumber       String            @unique
  vehicleId             String
  depotId               String
  type                  MaintenanceType
  priority              WorkOrderPriority @default(MEDIUM)
  status                WorkOrderStatus   @default(OPEN)
  title                 String
  description           String?
  reportedById          String?
  assignedToId          String?
  estimatedHours        Decimal?          @db.Decimal(6, 2)
  actualHours           Decimal?          @db.Decimal(6, 2)
  estimatedCost         Decimal?          @db.Decimal(10, 2)
  actualCost            Decimal?          @db.Decimal(10, 2)
  startedAt             DateTime?         @db.Timestamptz
  completedAt           DateTime?         @db.Timestamptz
  // A5: when the service is *planned* for (may differ from startedAt).
  // Availability treats any OPEN/ASSIGNED/IN_PROGRESS/AWAITING_PARTS work
  // order whose scheduled window overlaps a booking request as a conflict.
  scheduledStartAt      DateTime?         @db.Timestamptz
  scheduledEndAt        DateTime?         @db.Timestamptz
  labourCost            Decimal?          @db.Decimal(10, 2)
  partsCost             Decimal?          @db.Decimal(10, 2)
  externalSupplier      String?
  externalInvoiceRef    String?
  notes                 String?
  attachments           String[]
  odometerAtService     Int?
  relatedIncidentId     String?
  relatedInspectionId   String?
  relatedDamageChargeId String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  deletedAt             DateTime?

  vehicle       Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  depot         Depot             @relation(fields: [depotId], references: [id])
  reportedBy    User?             @relation("WorkOrderReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  assignedTo    User?             @relation("WorkOrderAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  parts         MaintenancePart[]
  logs          MaintenanceLog[]
  damageCharges DamageCharge[]
  documents     VehicleDocument[] @relation("WorkOrderDocuments")
  bookingSwap   BookingSwap?

  @@index([status])
  @@index([vehicleId])
  @@index([priority])
  @@index([assignedToId])
  @@index([depotId, status, scheduledStartAt])
  @@index([deletedAt])
}

model MaintenancePart {
  id          String   @id @default(cuid())
  workOrderId String
  partName    String
  partNumber  String?
  supplier    String?
  quantity    Int      @default(1)
  unitCost    Decimal  @db.Decimal(10, 2)
  totalCost   Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  workOrder MaintenanceWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

model MaintenanceLog {
  id            String   @id @default(cuid())
  workOrderId   String
  action        String
  performedById String?
  notes         String?
  timestamp     DateTime @default(now())

  workOrder MaintenanceWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

