// Identity path declared by a customer during checkout. AU_LICENCE means
// an Australian driver's licence suffices (licenceState is populated,
// licenceCountry is null). INTERNATIONAL means the customer is presenting
// an International Driver's Permit — licenceCountry is populated and a
// passport is also mandatory.
enum LicenceType {
  AU_LICENCE
  INTERNATIONAL
}

