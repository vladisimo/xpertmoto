// ============================================================================
// PRICING
// ============================================================================

model PricingRule {
  id           String          @id @default(cuid())
  categoryId   String
  depotId      String?
  name         String
  ruleType     PricingRuleType
  minDays      Int?
  maxDays      Int?
  pricePerUnit Decimal         @db.Decimal(10, 2)
  seasonId     String?
  dayOfWeek    Int[]
  priority     Int             @default(0)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())

  category VehicleCategory @relation(fields: [categoryId], references: [id])
  season   Season?         @relation(fields: [seasonId], references: [id])

  @@index([categoryId])
  @@index([seasonId])
  @@index([isActive])
}

/// Progressive ("tax-bracket") pricing ladder for rentals. Exactly one of
/// categoryId or vehicleId is set: category tiers apply as the default for
/// every vehicle in the category; vehicle tiers override the category ladder
/// for that specific unit. A booking's base total is the sum of tierTotal
/// for fully-spanned tiers, plus pro-rata for the final partial tier.
model PricingTier {
  id         String   @id @default(cuid())
  categoryId String?
  modelId    String?
  vehicleId  String?
  minDays    Int
  maxDays    Int
  // PROGRESSIVE tiers use `tierTotal` (slab total). PER_WEEK tiers use
  // `pricePerWeek` (× ceil(days/7)) within the slab. Exactly one of the
  // two should be non-null per row — enforced by `tierMode`.
  tierTotal    Decimal  @default(0) @db.Decimal(10, 2)
  tierMode     TierMode @default(PROGRESSIVE)
  pricePerWeek Decimal? @db.Decimal(10, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category VehicleCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  model    VehicleModel?    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  vehicle  Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([categoryId, minDays])
  @@index([modelId, minDays])
  @@index([vehicleId, minDays])
}

model Season {
  id         String   @id @default(cuid())
  name       String
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  multiplier Decimal  @db.Decimal(5, 2)
  depotId    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pricingRules PricingRule[]

  @@index([isActive, startDate, endDate])
  @@index([depotId])
}

// C5: one-way rental fees. Per (fromDepotId, toDepotId) pair, staff can
// either charge a flat fee or disallow the pair entirely. Availability
// and the pricing quote both consult this table when pickupDepotId !=
// returnDepotId. Same-depot rentals don't touch this table.
model OneWayFee {
  id          String   @id @default(cuid())
  fromDepotId String
  toDepotId   String
  feeAmount   Decimal  @default(0) @db.Decimal(10, 2)
  allowed     Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fromDepot Depot @relation("OneWayFeeFrom", fields: [fromDepotId], references: [id])
  toDepot   Depot @relation("OneWayFeeTo", fields: [toDepotId], references: [id])

  @@unique([fromDepotId, toDepotId])
}

model Package {
  id           String   @id @default(cuid())
  name         String
  description  String?
  categoryId   String
  durationDays Int
  totalPrice   Decimal  @db.Decimal(10, 2)
  inclusions   Json     @default("[]")
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category VehicleCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([isActive])
}

model Addon {
  id          String    @id @default(cuid())
  name        String
  description String?
  type        AddonType
  dailyRate   Decimal?  @db.Decimal(10, 2)
  flatRate    Decimal?  @db.Decimal(10, 2)
  isPerDay    Boolean   @default(true)
  isRequired  Boolean   @default(false)
  maxQuantity Int       @default(1)
  depotId     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bookingAddons BookingAddon[]

  @@index([isActive])
  @@index([depotId])
}

model Discount {
  id                    String       @id @default(cuid())
  code                  String       @unique
  description           String?
  type                  DiscountType
  value                 Decimal      @db.Decimal(10, 2)
  minBookingDays        Int?
  minBookingValue       Decimal?     @db.Decimal(10, 2)
  maxUses               Int?
  usedCount             Int          @default(0)
  validFrom             DateTime?    @db.Date
  validTo               DateTime?    @db.Date
  applicableCategoryIds String[]
  applicableDepotIds    String[]
  isActive              Boolean      @default(true)
  isAutoApply           Boolean      @default(false)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([isActive])
}

model InsuranceOption {
  id              String   @id @default(cuid())
  name            String
  description     String?
  dailyRate       Decimal  @db.Decimal(10, 2)
  excessAmount    Decimal  @db.Decimal(10, 2)
  coverageDetails Json     @default("{}")
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookingInsurance BookingInsurance[]

  @@index([isActive])
}

// ============================================================================
// BOOKINGS
// ============================================================================

/// Financial + audit record. MUST NOT be hard-deleted — use `deletedAt` only.
/// Australian tax law requires 7-year retention. Use VOID/CANCELLED/DISPUTED
/// status transitions for lifecycle; hard delete is blocked by the Prisma
/// extension in src/lib/prisma.ts.
// Phase A1 — see VehicleCategory.onlinePaymentStrategy.
enum OnlinePaymentStrategy {
  FULL
  FLAT
  PERCENT
  ZERO
}

// Phase A2 — cadence for progressive billing on long-term hires.
enum BillingFrequency {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

// Phase A2 — lifecycle of a BookingBillingPlan.
enum BookingBillingStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model Booking {
  id                   String        @id @default(cuid())
  bookingReference     String        @unique
  customerId           String
  vehicleId            String?
  categoryId           String
  depotId              String
  pickupDepotId        String
  returnDepotId        String
  status               BookingStatus @default(QUOTE)
  source               BookingSource @default(WEBSITE)
  pickupDateTime       DateTime      @db.Timestamptz
  returnDateTime       DateTime      @db.Timestamptz
  actualPickupDateTime DateTime?     @db.Timestamptz
  actualReturnDateTime DateTime?     @db.Timestamptz
  durationDays         Int
  pickupOdometerKm     Int?
  returnOdometerKm     Int?
  subtotal             Decimal       @db.Decimal(10, 2)
  discountAmount       Decimal       @default(0) @db.Decimal(10, 2)
  addonTotal           Decimal       @default(0) @db.Decimal(10, 2)
  insuranceTotal       Decimal       @default(0) @db.Decimal(10, 2)
  bondAmount           Decimal       @default(0) @db.Decimal(10, 2)
  gstAmount            Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount          Decimal       @db.Decimal(10, 2)
  amountPaid           Decimal       @default(0) @db.Decimal(10, 2)
  balanceDue           Decimal       @default(0) @db.Decimal(10, 2)
  // Phase A1 — snapshot of how much the customer was asked to pay during
  // the booking wizard (strategy-dependent: FULL = totalAmount, FLAT =
  // bookingFeeFlat, PERCENT = totalAmount * bookingFeePercent/100, ZERO =
  // 0). The remainder is carried on balanceDue. Progressive billing uses
  // firstPeriodAmount; see pricingSnapshot for the full breakdown.
  payOnlineAmount      Decimal       @default(0) @db.Decimal(10, 2)
  pricingSnapshot      Json          @default("{}")
  notes                String?
  internalNotes        String?
  staffNotes           String?
  isDelivery           Boolean       @default(false)
  deliveryAddress      String?
  deliveryFee          Decimal       @default(0) @db.Decimal(10, 2)
  agreedToTerms        Boolean       @default(false)
  termsVersion         String?
  signatureUrl         String?
  customerIdVerified   Boolean       @default(false)
  licenceVerified      Boolean       @default(false)
  extensionOfId        String?
  createdById          String?
  confirmedById        String?
  checkedOutById       String?
  checkedInById        String?
  cancelledById        String?
  cancellationReason   String?
  // B2: tracks which escalation stage the overdue job has reached for
  // this booking (0 = none, 1 = initial OVERDUE notice at +1h, 2 = +12h,
  // 3 = +24h manager escalation, 4 = +72h auto-incident created). Stored
  // on the booking so the job stays idempotent.
  overdueStage         Int           @default(0)
  // Lever 6: abandoned-cart recovery stage (0 = none, 1 = 30-min hold
  // nudge, 2 = 2h discount offer, 3 = 12h last-chance). Incremented by
  // the cart-recovery job; prevents duplicate emails.
  recoveryStage        Int           @default(0)
  // Lever 4: partner / hotel-concierge attribution. Populated when the
  // booking comes through a partner code or widget referral. Commission
  // is calculated on completed bookings.
  partnerId            String?
  partnerCode          String?
  // Lever 1: applied yield-pricing multiplier snapshot at booking time.
  yieldMultiplier      Decimal       @default(1) @db.Decimal(5, 3)
  // Lever 2: geofence/zone surcharges totalled at return.
  zoneSurchargeTotal   Decimal       @default(0) @db.Decimal(10, 2)
  // Lever 2: fuel-delivery dispatch fees totalled during rental.
  fuelDeliveryTotal    Decimal       @default(0) @db.Decimal(10, 2)
  // Lever honourable: cleaning fee charged at return when an inspection
  // item flags excessive cleaning required.
  cleaningFee          Decimal       @default(0) @db.Decimal(10, 2)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  customer     User            @relation("BookingCustomer", fields: [customerId], references: [id])
  vehicle      Vehicle?        @relation(fields: [vehicleId], references: [id])
  category     VehicleCategory @relation(fields: [categoryId], references: [id])
  depot        Depot           @relation(fields: [depotId], references: [id])
  pickupDepot  Depot           @relation("PickupDepot", fields: [pickupDepotId], references: [id])
  returnDepot  Depot           @relation("ReturnDepot", fields: [returnDepotId], references: [id])
  createdBy    User?           @relation("BookingCreatedBy", fields: [createdById], references: [id])
  confirmedBy  User?           @relation("BookingConfirmedBy", fields: [confirmedById], references: [id])
  checkedOutBy User?           @relation("BookingCheckedOutBy", fields: [checkedOutById], references: [id])
  checkedInBy  User?           @relation("BookingCheckedInBy", fields: [checkedInById], references: [id])
  cancelledBy  User?           @relation("BookingCancelledBy", fields: [cancelledById], references: [id])
  extensionOf  Booking?        @relation("BookingExtension", fields: [extensionOfId], references: [id], onDelete: SetNull)
  extensions   Booking[]       @relation("BookingExtension")

  addons                         BookingAddon[]
  insurance                      BookingInsurance[]
  payments                       Payment[]
  bookingNotes                   BookingNote[]
  statusLog                      BookingStatusLog[]
  inspections                    Inspection[]
  invoices                       Invoice[]
  incidents                      Incident[]
  infringements                  Infringement[]
  bondLedger                     BondLedger?
  rentalAgreements               RentalAgreement[]
  returnAssessments              ReturnAssessment[]
  adjustmentNotes                AdjustmentNote[]
  supportConversations           SupportConversation[]
  supportConversationsAttributed SupportConversation[] @relation("SupportConvAttributedBooking")
  visitorConversions             VisitorSession[]      @relation("VisitorSessionConvertedBooking")
  supportTickets                 SupportTicket[]
  // Lever 5: customer review captured after return.
  review                         Review?
  // Lever 4: partner who referred this booking (if any).
  partner                        Partner?              @relation(fields: [partnerId], references: [id])
  partnerTransactions            PartnerTransaction[]
  // Lever 2: rental zone polygon attached at pickup; events during rental.
  rentalZone                     RentalZone?
  zoneEvents                     ZoneEvent[]
  speedEvents                    SpeedEvent[]
  serviceDispatches              ServiceDispatch[]
  // Lever 9: loyalty points awarded when booking completes.
  loyaltyLedger                  LoyaltyLedger[]
  // Lever 3: when this booking was fulfilled via a subscription.
  subscriptionId                 String?
  subscription                   Subscription?         @relation(fields: [subscriptionId], references: [id])
  // Phase A2 — optional progressive-billing plan attached to this booking.
  billingPlan                    BookingBillingPlan?
  Referral                       Referral[]
  // Mid-rental vehicle swap events. DRAFT rows created when staff enters
  // the swap wizard; COMMITTED on confirm; VOIDED on abandonment.
  swaps                          BookingSwap[]

  @@index([status])
  @@index([customerId])
  @@index([vehicleId])
  @@index([categoryId])
  @@index([source])
  @@index([extensionOfId])
  @@index([pickupDateTime])
  @@index([returnDateTime])
  @@index([depotId, status, pickupDateTime])
  @@index([depotId, pickupDateTime, returnDateTime])
  @@index([customerId, status, pickupDateTime(sort: Desc)])
  @@index([status, returnDateTime])
  @@index([vehicleId, status, pickupDateTime])
  @@index([partnerId])
  @@index([subscriptionId])
  @@index([deletedAt])
}

// Phase A2 — progressive billing plan attached to a long-term hire.
// The first period + bond are charged online at booking time; this plan
// then drives recurring charges on the customer's stored card via the
// booking-billing job. Status moves to COMPLETED when nextChargeAt passes
// the booking's returnDateTime, or CANCELLED if the booking is cancelled.
model BookingBillingPlan {
  id                    String               @id @default(cuid())
  bookingId             String               @unique
  frequency             BillingFrequency
  amountPerPeriod       Decimal              @db.Decimal(10, 2)
  gstPerPeriod          Decimal              @default(0) @db.Decimal(10, 2)
  periodsTotal          Int // total number of recurring charges expected
  periodsCompleted      Int                  @default(0)
  nextChargeAt          DateTime             @db.Timestamptz
  lastChargedAt         DateTime?            @db.Timestamptz
  chargesAttempted      Int                  @default(0)
  chargesSucceeded      Int                  @default(0)
  chargesFailed         Int                  @default(0)
  status                BookingBillingStatus @default(ACTIVE)
  stripePaymentMethodId String?
  pauseReason           String?
  cancelReason          String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status, nextChargeAt])
}

model BookingAddon {
  id         String   @id @default(cuid())
  bookingId  String
  addonId    String
  quantity   Int      @default(1)
  unitPrice  Decimal  @db.Decimal(10, 2)
  totalPrice Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addon   Addon   @relation(fields: [addonId], references: [id])

  @@index([bookingId])
  @@index([addonId])
}

model BookingInsurance {
  id                String   @id @default(cuid())
  bookingId         String
  insuranceOptionId String
  dailyRate         Decimal  @db.Decimal(10, 2)
  totalPrice        Decimal  @db.Decimal(10, 2)
  // Lever 7: tracks where an insurance attach came from. WIZARD for
  // booking-flow selection; the others are mid-/pre-rental upsells.
  addedAt           DateTime @default(now())
  source            String   @default("WIZARD") // WIZARD | PRE_PICKUP_UPSELL | MID_RENTAL | WEATHER_TRIGGER | TELEMETRY_TRIGGER

  booking         Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  insuranceOption InsuranceOption @relation(fields: [insuranceOptionId], references: [id])

  @@index([bookingId])
  @@index([insuranceOptionId])
  @@index([source])
}

model BookingNote {
  id         String   @id @default(cuid())
  bookingId  String
  userId     String
  note       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([bookingId])
  @@index([userId])
}

model BookingStatusLog {
  id             String         @id @default(cuid())
  bookingId      String
  previousStatus BookingStatus?
  newStatus      BookingStatus
  changedById    String?
  reason         String?
  timestamp      DateTime       @default(now()) @db.Timestamptz
  createdAt      DateTime       @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([timestamp])
}

// ============================================================================
// PAYMENTS & FINANCE
// ============================================================================

/// Financial ledger — single source of truth for cash flows. MUST NOT be
/// hard-deleted; use `deletedAt` only for archival. 7-year ATO retention.
model Payment {
  id                    String        @id @default(cuid())
  reference             String        @unique
  customerId            String?
  bookingId             String?
  type                  PaymentType
  method                PaymentMethod
  amount                Decimal       @db.Decimal(10, 2)
  gstAmount             Decimal       @default(0) @db.Decimal(10, 2)
  stripePaymentIntentId String?
  stripeChargeId        String?
  status                PaymentStatus @default(PENDING)
  // Stripe-hosted receipt URL (returned by the charge object). Kept
  // for audit; not the customer-facing branded receipt.
  receiptUrl            String?
  // Branded receipt PDF generated by the platform on payment success.
  // Persisted to S3/MinIO via uploadFile(); referenced here so the
  // booking + customer documents pages can link it without
  // re-rendering. Distinct from receiptUrl (which is Stripe's).
  receiptPdfUrl         String?
  receiptPdfKey         String?
  receiptNumber         String?       @unique
  notes                 String?
  processedById         String?
  processedAt           DateTime?     @db.Timestamptz
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?

  customer       User?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  booking        Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  events         PaymentEvent[]
  swap           BookingSwap?
  adjustmentNote AdjustmentNote?

  @@index([bookingId])
  @@index([customerId])
  @@index([status])
  @@index([type])
  @@index([bookingId, status, createdAt])
  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([type, status, createdAt])
  @@index([deletedAt])
}

/// GST/BAS tax record. ABN appears on invoice. MUST NOT be hard-deleted
/// (ATO 7-year retention). Use status VOID for lifecycle voids; downstream
/// changes to a SENT/PAID invoice are recorded as `AdjustmentNote` rows
/// (positive or negative) referencing this invoice. The original
/// subtotal/gstAmount/totalAmount on this row are IMMUTABLE once issued —
/// the booking's running financial picture = this invoice + sum of its
/// adjustment notes.
model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  customerId    String?
  bookingId     String?
  lineItems     Json          @default("[]")
  subtotal      Decimal       @db.Decimal(10, 2)
  gstAmount     Decimal       @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(10, 2)
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime?     @db.Date
  // Distinct from createdAt: the moment status moved to SENT and the
  // document number was committed. Drives the FY counter scope and the
  // displayed "Issue date" on the PDF.
  issuedAt      DateTime?     @db.Timestamptz
  sentAt        DateTime?     @db.Timestamptz
  paidAt        DateTime?     @db.Timestamptz
  pdfUrl        String?
  pdfKey        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  booking         Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  creditNotes     CreditNote[]
  adjustmentNotes AdjustmentNote[]

  @@index([customerId])
  @@index([bookingId])
  @@index([status])
  @@index([issuedAt])
  @@index([deletedAt])
}

/// Refund audit trail — MUST NOT be hard-deleted.
///
/// Legacy: existed before the `AdjustmentNote` lifecycle. Retained because
/// `BookingSwap.creditNoteId` still references it for downgrades that
/// settle via account credit (Stripe charge >180 days old). New issuance
/// goes through AdjustmentNote; CreditNote is kept for back-compat and
/// can be retired in a follow-up once swaps migrate.
model CreditNote {
  id         String    @id @default(cuid())
  invoiceId  String
  amount     Decimal   @db.Decimal(10, 2)
  reason     String
  issuedById String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  bookingSwap BookingSwap?

  @@index([invoiceId])
  @@index([deletedAt])
}

/// ATO §29-75 adjustment note. Issued whenever the consideration for a
/// taxable supply changes after the original tax invoice was issued —
/// extensions, vehicle swaps, damage charges, late/fuel/cleaning fees,
/// infringement recovery, cancellation refunds, manual corrections.
///
/// `type = INCREASE` adds to the booking's running total (positive
/// adjustment); `type = DECREASE` reduces it. The original Invoice row's
/// subtotal/gstAmount/totalAmount are immutable; the booking's true
/// financial position = invoice.totalAmount + Σ adjustmentNotes.totalAmount
/// (with DECREASE values stored as positive numbers and subtracted).
///
/// MUST NOT be hard-deleted (7-year retention). Use `status = VOID` to
/// mark issued-in-error; never delete.
model AdjustmentNote {
  id               String               @id @default(cuid())
  adjustmentNumber String               @unique // e.g. ADJ-2026-000001
  invoiceId        String
  bookingId        String?
  customerId       String?
  type             AdjustmentType
  reason           AdjustmentReason
  // Customer-facing description rendered prominently on the PDF — eg
  // "2-day rental extension", "Vehicle upgrade to 150cc", "Damage to
  // front fairing", "Late return fee (3hr)".
  description      String
  // JSON-serialised line items (description, quantity, unitPrice,
  // gstAmount, totalPrice). Validated by AdjustmentNoteLineItemSchema.
  lineItems        Json                 @default("[]")
  // Always stored as positive values; `type` indicates direction.
  subtotal         Decimal              @db.Decimal(10, 2)
  gstAmount        Decimal              @db.Decimal(10, 2)
  totalAmount      Decimal              @db.Decimal(10, 2)
  status           AdjustmentNoteStatus @default(ISSUED)
  pdfUrl           String?
  pdfKey           String?
  issuedAt         DateTime             @default(now()) @db.Timestamptz
  issuedById       String?
  // The Payment row that captured (INCREASE) or refunded (DECREASE) the
  // delta. Nullable because some adjustments — eg waived fees, manual
  // correction credits — don't move money. 1:1 when present.
  paymentId        String?              @unique
  // Marketing / accounting void reason; populated when status = VOID.
  voidReason       String?
  voidedAt         DateTime?            @db.Timestamptz
  voidedById       String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?

  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customer User?    @relation("AdjustmentNoteCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  issuedBy User?    @relation("AdjustmentNoteIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  payment  Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([bookingId])
  @@index([customerId])
  @@index([issuedAt])
  @@index([reason])
  @@index([deletedAt])
}

enum AdjustmentType {
  INCREASE
  DECREASE
}

enum AdjustmentReason {
  EXTENSION
  SWAP
  DAMAGE
  LATE_FEE
  FUEL
  CLEANING
  ZONE_SURCHARGE
  INFRINGEMENT
  CANCELLATION
  REFUND
  MANUAL
  OTHER
}

enum AdjustmentNoteStatus {
  ISSUED
  VOID
}

/// Per-(documentType, financialYear) sequence counter used by the
/// document-numbering service to generate monotonic, FY-scoped numbers
/// (INV-2026-000001, ADJ-2026-000001, RCT-2026-000001).
///
/// Reads use SELECT … FOR UPDATE inside the issuing transaction to
/// guarantee no duplicate numbers under concurrency. Australian FY ends
/// 30 June; FY 2026 = 1 Jul 2025 → 30 Jun 2026.
model DocumentCounter {
  documentType  TaxDocumentType
  financialYear Int
  nextValue     Int             @default(1)
  updatedAt     DateTime        @updatedAt

  @@id([documentType, financialYear])
}

enum TaxDocumentType {
  INVOICE
  ADJUSTMENT_NOTE
  RECEIPT
}

/// Bond financial record (Stripe hold + capture history). MUST NOT be
/// hard-deleted — breaks bond reconciliation.
model BondLedger {
  id                    String     @id @default(cuid())
  bookingId             String     @unique
  customerId            String
  heldAmount            Decimal    @db.Decimal(10, 2)
  capturedAmount        Decimal    @default(0) @db.Decimal(10, 2)
  releasedAmount        Decimal    @default(0) @db.Decimal(10, 2)
  status                BondStatus @default(HELD)
  stripePaymentIntentId String?
  deductions            Json       @default("[]")
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  deletedAt             DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([status])
  @@index([deletedAt])
}

model DailyRevenue {
  id              String   @id @default(cuid())
  date            DateTime @db.Date
  depotId         String
  bookingRevenue  Decimal  @default(0) @db.Decimal(12, 2)
  addonRevenue    Decimal  @default(0) @db.Decimal(12, 2)
  damageRevenue   Decimal  @default(0) @db.Decimal(12, 2)
  lateFeesRevenue Decimal  @default(0) @db.Decimal(12, 2)
  totalRevenue    Decimal  @default(0) @db.Decimal(12, 2)
  totalGst        Decimal  @default(0) @db.Decimal(12, 2)
  totalRefunds    Decimal  @default(0) @db.Decimal(12, 2)
  netRevenue      Decimal  @default(0) @db.Decimal(12, 2)

  @@unique([date, depotId])
}

/// Mid-rental vehicle swap event. First-class record of the swap — links
/// the outgoing and incoming vehicles, the paired POST_HIRE / PRE_HIRE
/// inspections, any fault work order or accident incident, the price
/// adjustment Payment (charge or refund), and the signed agreement PDF.
///
/// Pricing rule: `reason` drives cost impact. Spec changes (UPGRADE /
/// DOWNGRADE / LATERAL) can settle a delta; fault and operational reasons
/// force `priceAdjustment = 0` regardless of the incoming vehicle's rate.
/// `origin` is audit-only and does not affect pricing.
///
/// MUST NOT be hard-deleted — referenced by Stripe refunds and work-order
/// audit trails. Use `status = VOIDED` to mark abandoned DRAFT rows.
model BookingSwap {
  id                       String             @id @default(cuid())
  bookingId                String
  outgoingVehicleId        String
  incomingVehicleId        String?
  swappedAt                DateTime           @default(now()) @db.Timestamptz
  swappedById              String
  reason                   SwapReason
  origin                   SwapOrigin
  reasonNotes              String
  // Free-form reference to where this was raised: support ticket #, call
  // log ref, telematics event id. Shown verbatim to the repair shop on
  // fault swaps so the technician sees the customer's wording.
  originDetails            String?
  priceAdjustmentAmount    Decimal            @default(0) @db.Decimal(10, 2)
  priceAdjustmentGst       Decimal            @default(0) @db.Decimal(10, 2)
  // Positive = customer pays, negative = customer refunded, zero = no change.
  priceAdjustmentDirection SwapPriceDirection @default(NONE)
  paymentId                String?            @unique
  outgoingInspectionId     String?            @unique
  incomingInspectionId     String?            @unique
  workOrderId              String?            @unique
  incidentId               String?            @unique
  documentUrl              String?
  customerSignatureUrl     String?
  staffSignatureUrl        String?
  // When the original Stripe charge is too old for refund (>180d), the
  // downgrade settles via a CreditNote against the booking invoice instead.
  creditNoteId             String?            @unique
  // Set when the new category's bond amount differs from the old — we do
  // NOT resize the Stripe hold; we surface the variance here for audit.
  bondVarianceAmount       Decimal?           @db.Decimal(10, 2)
  status                   BookingSwapStatus  @default(DRAFT)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  deletedAt                DateTime?

  booking            Booking               @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  outgoingVehicle    Vehicle               @relation("BookingSwapOutgoingVehicle", fields: [outgoingVehicleId], references: [id], onDelete: Restrict)
  incomingVehicle    Vehicle?              @relation("BookingSwapIncomingVehicle", fields: [incomingVehicleId], references: [id], onDelete: Restrict)
  swappedBy          User                  @relation("BookingSwapSwappedBy", fields: [swappedById], references: [id])
  payment            Payment?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  outgoingInspection Inspection?           @relation("BookingSwapOutgoingInspection", fields: [outgoingInspectionId], references: [id], onDelete: SetNull)
  incomingInspection Inspection?           @relation("BookingSwapIncomingInspection", fields: [incomingInspectionId], references: [id], onDelete: SetNull)
  workOrder          MaintenanceWorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  incident           Incident?             @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  creditNote         CreditNote?           @relation(fields: [creditNoteId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([outgoingVehicleId])
  @@index([incomingVehicleId])
  @@index([status, createdAt])
  @@index([reason])
  @@index([deletedAt])
}

enum SwapPriceDirection {
  NONE
  CHARGE
  REFUND
}

