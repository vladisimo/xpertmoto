/// Length of the base-rate billing window. `H24` = standard daily rate;
/// `H48` = the base rate covers any 1–2 day rental (xpertmoto.com.au's
/// big-bike model). Used by VehicleModel (default) and Vehicle override.
enum BasePeriodHours {
  H24
  H48
}

/// Discriminates how a PricingTier row is priced.
/// - `PROGRESSIVE`: existing additive "tax-bracket" math — pays `tierTotal`
///   for each fully-spanned tier and pro-rata for the partial tail.
/// - `PER_WEEK`: xpertmoto.com.au's model — pays `pricePerWeek × weeks`
///   for any rental whose day count falls within `[minDays, maxDays]`.
enum TierMode {
  PROGRESSIVE
  PER_WEEK
}

