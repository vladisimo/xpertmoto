  deliveryNote  String?
  proofPhotoUrl String?
  paymentId     String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
  @@index([type])
}

