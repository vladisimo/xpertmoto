// ============================================================================
// STRIPE WEBHOOK EVENT LOG (G1 — Phase 4 P0)
//
// Insert-then-process dedup table for Stripe webhook events. The handler
// inserts a row keyed on the Stripe event id before doing any side-effect
// work; the @id unique constraint makes replays a no-op. Tracks attempts +
// failure reason so missed / failed events can be resent via
// `stripe events resend evt_...` — see docs/payments/runbook-webhook-replay.md
// ============================================================================

enum StripeWebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

model StripeWebhookEvent {
  id          String                   @id
  type        String
  apiVersion  String?
  livemode    Boolean                  @default(false)
  payload     Json
  receivedAt  DateTime                 @default(now())
  processedAt DateTime?
  status      StripeWebhookEventStatus @default(RECEIVED)
  errorReason String?
  attempts    Int                      @default(0)

  paymentEvents PaymentEvent[]

  @@index([type, receivedAt])
  @@index([status, receivedAt])
}

// ============================================================================
// PAYMENT EVENT LOG (G9 — Phase 4 P1)
//
// Append-only history of every Payment.status mutation. Enables replay
// tests, forensic audit, and reconciliation invariant checks.
// ============================================================================

enum PaymentEventType {
  CREATED
  STATUS_CHANGED
  CAPTURED
  REFUNDED
  DISPUTED
  VOIDED
  RETRY_ATTEMPTED
  RETRY_EXHAUSTED
}

model PaymentEvent {
  id             String           @id @default(cuid())
  paymentId      String
  eventType      PaymentEventType
  previousStatus PaymentStatus?
  newStatus      PaymentStatus?
  amountDelta    Decimal?         @db.Decimal(10, 2)
  source         String
  stripeEventId  String?
  actorUserId    String?
  data           Json             @default("{}")
  createdAt      DateTime         @default(now())

  payment            Payment             @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  stripeWebhookEvent StripeWebhookEvent? @relation(fields: [stripeEventId], references: [id])

  @@index([paymentId, createdAt])
  @@index([stripeEventId])
  @@index([eventType, createdAt])
  @@index([actorUserId])
}

// ============================================================================
// STRIPE FEE LEDGER (G3 — Phase 4 P1)
//
// Per-charge Stripe fee record. Populated by the stripe-reconcile job from
// /v1/balance_transactions. Feeds the net-revenue reports + month-end
// close.
// ============================================================================

model StripeFeeLedger {
  id                  String    @id @default(cuid())
  stripeChargeId      String    @unique
  stripePayoutId      String?
  feeType             String
  feeAmountCents      Int
  netAmountCents      Int
  currency            String    @default("aud")
  balanceTxnCreatedAt DateTime
  payoutArrivedAt     DateTime?
  createdAt           DateTime  @default(now())

  @@index([stripePayoutId])
  @@index([balanceTxnCreatedAt])
}

// ============================================================================
// UNMATCHED TRANSACTIONS (G3 — Phase 4 P1)
//
// Queue of reconciliation discrepancies. See
// docs/payments/runbook-reconciliation-variance.md for the resolution
// procedure.
// ============================================================================

enum UnmatchedTransactionSource {
  STRIPE_CHARGE
  STRIPE_PAYOUT
  BANK_STATEMENT
  SYSTEM_LEDGER
}

model UnmatchedTransaction {
  id           String                     @id @default(cuid())
  source       UnmatchedTransactionSource
  externalId   String
  amountCents  Int
  occurredAt   DateTime
  reason       String
  resolvedAt   DateTime?
  resolvedById String?
  resolvedNote String?
  payload      Json
  createdAt    DateTime                   @default(now())

  @@unique([source, externalId])
  @@index([source, resolvedAt])
  @@index([occurredAt])
  @@index([resolvedById])
}

// ============================================================================
// DATABASE BACKUPS
//
// Scheduled pg_dump history. The job inserts a row before + after each
// dump so operators can see what's stored, when it ran, and whether the
// retention sweep has cleared anything recently.
// ============================================================================

enum BackupStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum BackupTrigger {
  SCHEDULED
  MANUAL_ADMIN
}

model DatabaseBackup {
  id             String        @id @default(cuid())
  startedAt      DateTime      @default(now())
  completedAt    DateTime?
  sizeBytes      BigInt?
  storageUrl     String?
  status         BackupStatus  @default(RUNNING)
  errorMessage   String?
  triggeredBy    BackupTrigger
  triggeredById  String?
  retentionUntil DateTime?
  schemaVersion  String?

  @@index([startedAt])
  @@index([status])
  @@index([retentionUntil])
}

// ============================================================================
// USER TOTP (2FA)
//
// Staff TOTP secret + one-shot recovery codes. The secret is encrypted at
// rest via the AES-256-GCM helpers in src/lib/crypto.ts — the plaintext
// secret is only decrypted in-memory during verification. Recovery codes
// are hashed (bcrypt) and consumed on use.
// ============================================================================

model UserTotp {
  id              String    @id @default(cuid())
  userId          String    @unique
  encryptedSecret Json
  recoveryCodes   Json      @default("[]")
  enabled         Boolean   @default(false)
  enabledAt       DateTime?
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// PLATFORM COST TRACKING
//
// One row per billable / observable event across each cost centre, written
// at the capture site (model call, SMS/email send, S3 put/delete, HTTP
// request, etc). Per-customer / per-booking attribution is carried through
// so the Platform admin area can answer "what did customer X cost?".
// ============================================================================

/// Per-call record of document extraction (licence / passport OCR) via the
/// Claude vision wrapper in `src/server/services/document-extract.ts`.
/// Sibling to SupportCostLog for the tech-support chatbot.
model OcrCostLog {
  id                  String   @id @default(cuid())
  kind                String
  provider            String
  model               String
  inputTokens         Int      @default(0)
  outputTokens        Int      @default(0)
  cachedInputTokens   Int      @default(0)
  cacheCreationTokens Int      @default(0)
  costAud             Decimal  @db.Decimal(10, 6)
  customerId          String?
  bookingId           String?
  triggeredById       String?
  outcome             String?
  createdAt           DateTime @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
  @@index([provider, createdAt])
  @@index([customerId])
  @@index([bookingId])
}

/// Per-message log of outbound SMS via Twilio. Populated immediately on
/// send; `priceAud` / `numSegments` are filled in by the existing
/// `/api/webhooks/twilio` status callback when Twilio settles the cost.
model TwilioMessageLog {
  id            String    @id @default(cuid())
  sid           String    @unique
  to            String
  body          String    @db.Text
  purpose       String?
  numSegments   Int?
  priceAud      Decimal?  @db.Decimal(10, 6)
  priceCurrency String?
  status        String    @default("queued")
  errorCode     String?
  errorMessage  String?
  customerId    String?
  bookingId     String?
  createdAt     DateTime  @default(now())
  deliveredAt   DateTime?
  updatedAt     DateTime  @updatedAt

  @@index([createdAt])
  @@index([customerId])
  @@index([bookingId])
  @@index([status, createdAt])
}

/// Per-send log of outbound email via Resend. Each `sendEmail()` call
/// writes one row immediately; the existing Resend webhook route enriches
/// `deliveredAt` / `bouncedAt` / `openedAt` when events arrive.
model EmailSendLog {
  id                String    @id @default(cuid())
  providerMessageId String?
  provider          String    @default("resend")
  toEmail           String
  fromEmail         String
  subject           String
  purpose           String?
  status            String    @default("queued")
  errorMessage      String?
  customerId        String?
  bookingId         String?
  createdAt         DateTime  @default(now())
  deliveredAt       DateTime?
  bouncedAt         DateTime?
  openedAt          DateTime?
  updatedAt         DateTime  @updatedAt

  @@index([createdAt])
  @@index([customerId])
  @@index([bookingId])
  @@index([provider, createdAt])
  @@index([providerMessageId])
}

enum StorageUsageAction {
  UPLOAD
  DELETE
}

/// Per-operation log of S3/MinIO puts and deletes. Byte deltas let the
/// Platform > Storage tab compute a running usage total without a nightly
/// full-bucket scan; a reconciling sweep can still be layered on later.
model StorageUsageEvent {
  id          String             @id @default(cuid())
  action      StorageUsageAction
  bucketKey   String
  folder      String
  contentType String?
  sizeBytes   BigInt
  customerId  String?
  bookingId   String?
  createdAt   DateTime           @default(now())

  @@index([createdAt])
  @@index([folder, createdAt])
  @@index([action, createdAt])
  @@index([customerId])
  @@index([bookingId])
}

/// Coarse-grained HTTP request log for bandwidth / request-volume costing.
/// Written by `src/middleware.ts` — one row per request is too noisy at
/// scale, so the middleware samples (see PLATFORM_REQUEST_SAMPLE_RATE env)
/// and the Platform > Server tab extrapolates from the sample.
model ServerRequestLog {
  id           String   @id @default(cuid())
  method       String
  path         String
  status       Int
  durationMs   Int?
  bytesOut     Int?
  userId       String?
  ipAddress    String?
  userAgent    String?
  sampleWeight Int      @default(1)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([status, createdAt])
}

/// Daily roll-up pulled from Sentry's Organizations Stats v2 API (and any
/// other observability provider later). One row per day per metric.
model ObservabilityUsageSnapshot {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  provider  String
  metric    String
  quantity  BigInt
  costAud   Decimal? @db.Decimal(10, 4)
  createdAt DateTime @default(now())

  @@unique([provider, metric, date])
  @@index([date])
  @@index([provider, date])
}
