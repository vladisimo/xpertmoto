enum DemandEventImpact {
  BOOST
  DIP
}

model PriceRecommendation {
  id                 String    @id @default(cuid())
  date               DateTime  @db.Date
  depotId            String
  categoryId         String
  baseMultiplier     Decimal   @default(1) @db.Decimal(5, 3)
  computedAt         DateTime  @default(now()) @db.Timestamptz
  forwardBookingPct  Decimal   @default(0) @db.Decimal(5, 2)
  demandScore        Decimal   @default(0) @db.Decimal(10, 4)
  reasonCodes        String[]
  isActive           Boolean   @default(true)
  overrideMultiplier Decimal?  @db.Decimal(5, 3)
  overriddenById     String?
  overriddenAt       DateTime? @db.Timestamptz

  @@unique([date, depotId, categoryId])
