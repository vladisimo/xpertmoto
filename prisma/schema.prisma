  referrer          User     @relation("ReferralReferrer", fields: [referrerId], references: [id])
  referee           User?    @relation("ReferralReferee", fields: [refereeId], references: [id])
  qualifyingBooking Booking? @relation(fields: [qualifyingBookingId], references: [id])

  @@index([referrerId])
  @@index([refereeId])
  @@index([code])
  @@index([status])
  @@index([qualifyingBookingId])
}

// ----------------------------------------------------------------------------
// Lever 9 — Loyalty ledger
