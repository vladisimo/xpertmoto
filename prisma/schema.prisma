// ============================================================================
// CORE — ORGANISATION / DEPOTS
// ============================================================================

model Organisation {
  id        String   @id @default(cuid())
  name      String
  abn       String
  logoUrl   String?
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Depot {
  id           String    @id @default(cuid())
  name         String
  // Soft-deleted depots are renamed (slug → `archived-<slug>-<ts>`) by the
  // `archiveDepot` service so that the same slug can be re-used for a new
  // depot without tripping the @unique constraint.
  slug         String    @unique
  addressLine1 String
  addressLine2 String?
  suburb       String
  state        String
  postcode     String
  country      String    @default("Australia")
  latitude     Float?
  longitude    Float?
  phone        String?
  email        String?
  timezone     String    @default("Australia/Brisbane")
  maxCapacity  Int       @default(50)
  isActive     Boolean   @default(true)
  // When a BREAKDOWN/ABANDONED_VEHICLE support ticket is raised URGENT
  // outside operating hours, the support-notify job SMS-pages this user.
  // Falls back to the first MANAGER at the depot if unset.
  onCallUserId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  operatingHours       DepotOperatingHours[]
  vehicles             Vehicle[]
  bookingsPickup       Booking[]              @relation("PickupDepot")
  bookingsReturn       Booking[]              @relation("ReturnDepot")
  bookings             Booking[]
  staff                User[]                 @relation("StaffDepot")
  onCallUser           User?                  @relation("DepotOnCall", fields: [onCallUserId], references: [id])
  inspections          Inspection[]
  workOrders           MaintenanceWorkOrder[]
  transfersFrom        VehicleTransfer[]      @relation("TransferFrom")
  transfersTo          VehicleTransfer[]      @relation("TransferTo")
  auditLogs            AuditLog[]
  oneWayFeesFrom       OneWayFee[]            @relation("OneWayFeeFrom")
  oneWayFeesTo         OneWayFee[]            @relation("OneWayFeeTo")
  supportConversations SupportConversation[]
  supportTickets       SupportTicket[]

  @@index([isActive])
  @@index([deletedAt])
  @@index([slug])
}

model DepotOperatingHours {
  id          String    @id @default(cuid())
  depotId     String
  dayOfWeek   Int // 0 = Sunday .. 6 = Saturday
  openTime    String // "08:00" — HH:MM (enforced in code)
  closeTime   String // "18:00" — HH:MM (enforced in code)
  isClosed    Boolean   @default(false)
  holidayDate DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  depot       Depot     @relation(fields: [depotId], references: [id], onDelete: Cascade)

  @@index([depotId, dayOfWeek])
  @@index([holidayDate])
}

// ============================================================================
// USERS
// ============================================================================

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  emailVerified     DateTime?  @db.Timestamptz
  phone             String?
  phoneVerified     DateTime?  @db.Timestamptz
  passwordHash      String?
  firstName         String
  lastName          String
  dateOfBirth       DateTime?  @db.Date
  avatarUrl         String?
  role              UserRole   @default(CUSTOMER)
  status            UserStatus @default(ACTIVE)
  depotId           String?
  lastLoginAt       DateTime?  @db.Timestamptz
  // Brute-force lockout (identity-layer). Paired with the IP-layer
  // rate-limit in src/lib/rate-limit.ts to cover rotating-proxy attacks.
  failedLoginCount  Int        @default(0)
  lockedUntil       DateTime?  @db.Timestamptz
  lastFailedLoginAt DateTime?  @db.Timestamptz
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?
  // Legacy migration: preserves the old system's driver_id for idempotent
  // re-runs and future cross-reference lookups. Nullable on users created
  // natively after launch.
  legacyDriverId    String?    @unique
  legacyImportedAt  DateTime?  @db.Timestamptz

  depot                    Depot?                 @relation("StaffDepot", fields: [depotId], references: [id])
  customerProfile          CustomerProfile?
  staffProfile             StaffProfile?
  accounts                 Account[]
  sessions                 Session[]
  impersonatedSessions     Session[]              @relation("SessionImpersonator")
  totp                     UserTotp?
  bookings                 Booking[]              @relation("BookingCustomer")
  createdBookings          Booking[]              @relation("BookingCreatedBy")
  confirmedBookings        Booking[]              @relation("BookingConfirmedBy")
  checkedOutBookings       Booking[]              @relation("BookingCheckedOutBy")
  checkedInBookings        Booking[]              @relation("BookingCheckedInBy")
  cancelledBookings        Booking[]              @relation("BookingCancelledBy")
  notes                    BookingNote[]
  payments                 Payment[]
  inspections              Inspection[]
  reportedIncidents        Incident[]             @relation("IncidentReportedBy")
  assignedIncidents        Incident[]             @relation("IncidentAssignedTo")
  incidentNotes            IncidentNote[]
  reportedWorkOrders       MaintenanceWorkOrder[] @relation("WorkOrderReportedBy")
  assignedWorkOrders       MaintenanceWorkOrder[] @relation("WorkOrderAssignedTo")
  bookingSwaps             BookingSwap[]          @relation("BookingSwapSwappedBy")
  uploadedVehicleDocuments VehicleDocument[]      @relation("UploadedVehicleDocuments")
  notifications            Notification[]
  analyticsSegments        AnalyticsSegment[]
  analyticsFunnels         AnalyticsFunnel[]
  analyticsAlerts          AnalyticsAlert[]
  auditLogs                AuditLog[]
  communications           CommunicationLog[]
  pushSubscriptions        PushSubscription[]
  rentalAgreements         RentalAgreement[]
  customerDocuments        CustomerDocument[]
  returnAssessments        ReturnAssessment[]
  adjustmentNotes          AdjustmentNote[]       @relation("AdjustmentNoteCustomer")
  issuedAdjustmentNotes    AdjustmentNote[]       @relation("AdjustmentNoteIssuedBy")
  damageChargesCreated     DamageCharge[]         @relation("DamageChargeCreatedBy")
  damageChargesResolved    DamageCharge[]         @relation("DamageChargeResolvedBy")
  supportConversations     SupportConversation[]
  supportTicketsAsCustomer SupportTicket[]        @relation("SupportTicketCustomer")
  supportTicketsAsAssignee SupportTicket[]        @relation("SupportTicketAssignee")
  supportTicketNotes       SupportTicketNote[]
  onCallForDepots          Depot[]                @relation("DepotOnCall")
  visitorSessions          VisitorSession[]
  staffTaskActivities      StaffTaskActivity[]    @relation("StaffTaskActivityStaff")
  // Revenue-lever back-relations
  reviews                  Review[]
  referralsMade            Referral[]             @relation("ReferralReferrer")
  referralsReceived        Referral[]             @relation("ReferralReferee")
  loyaltyLedger            LoyaltyLedger[]
  subscriptions            Subscription[]         @relation("SubscriptionCustomer")

  // To allow re-registration with the same email after soft-delete, the
  // `anonymiseUser` service rewrites `email` to a unique placeholder (see
  // src/server/services/anonymise-user.ts) freeing up the original address.
  @@index([role])
  @@index([depotId])
  @@index([status])
  @@index([deletedAt])
  @@index([role, deletedAt])
  @@index([legacyImportedAt])
}

model CustomerProfile {
  id                           String       @id @default(cuid())
  userId                       String       @unique
  // Plaintext columns retained during the APP-11 encryption rollout so
  // pre-migration reads still work. New writes land in the *Enc columns
  // via src/lib/customer-pii.ts; legacy reads fall back here until the
  // migration job (scripts/encrypt-licence-data.ts) has run everywhere.
  // After migration: DROP these columns in a follow-up migration.
  licenceNumber                String?
  licenceNumberEnc             Json?
  // Whether the licence row describes an AU driver's licence or an
  // International Driver's Permit. Gate-chosen in Step 4 of the booking
  // wizard; null for legacy rows until the customer re-answers the gate.
  licenceType                  LicenceType?
  licenceState                 String?
  // Issuing country (ISO-3166 alpha-2) for International Driver's
  // Permits. Null when licenceType = AU_LICENCE (use licenceState).
  licenceCountry               String?
  licenceExpiry                DateTime?    @db.Date
  licenceClass                 String?
  licenceImageFront            String?
  licenceImageBack             String?
  licenceVerifiedAt            DateTime?    @db.Timestamptz
  licenceVerifiedById          String?
  passportNumber               String?
  passportNumberEnc            Json?
  passportCountry              String?
  passportExpiry               DateTime?    @db.Date
  passportImage                String?
  passportVerifiedAt           DateTime?    @db.Timestamptz
  passportVerifiedById         String?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  termsAcceptedAt              DateTime?    @db.Timestamptz
  termsVersion                 String?
  privacyAcceptedAt            DateTime?    @db.Timestamptz
  privacyVersion               String?
  addressLine1                 String?
  addressLine2                 String?
  suburb                       String?
  state                        String?
  postcode                     String?
  country                      String?      @default("Australia")
  // B2B tax-invoice fields. ABN is captured (not verified against ABR);
  // when present, the recipient block on tax invoices renders
  // `companyName` and `ABN <abn>` so the document satisfies ATO §29-70
  // requirements for invoices over $1,000 issued to a business.
  companyName                  String?
  abn                          String?
  marketingOptIn               Boolean      @default(false)
  marketingSmsOptIn            Boolean      @default(false)
  marketingEmailUnsubscribedAt DateTime?    @db.Timestamptz
  marketingSmsUnsubscribedAt   DateTime?    @db.Timestamptz
  unsubscribeReason            String?
  notes                        String?
  customerSince                DateTime     @default(now())
  totalBookings                Int          @default(0)
  completedBookings            Int          @default(0)
  totalSpend                   Decimal      @default(0) @db.Decimal(12, 2)
  lastBookingAt                DateTime?    @db.Timestamptz
  incidentCount                Int          @default(0)
  loyaltyPoints                Int          @default(0)
  // Lever 9: loyalty tier derived from lifetime points; recalculated by
  // the loyalty service after each booking completion.
  loyaltyTier                  LoyaltyTier  @default(SILVER)
  lifetimePoints               Int          @default(0)
  // Lever 5: unique referral code the customer can share. One-way
  // generated at account creation; immutable.
  referralCode                 String?      @unique
  // Lever 5: applied referral credit balance (earned from referrals).
  referralCreditBalance        Decimal      @default(0) @db.Decimal(10, 2)
  blacklistReason              String?
  riskRating                   RiskRating   @default(LOW)
  // G6 (Phase 4 P0): Stripe Customer + stored payment method. Populated
  // lazily by ensureStripeCustomer() on first booking; enables off-session
  // capture for delayed recoveries (tolls, fines, damage excess). Only the
  // opaque Stripe token is stored — PAN / CVV never touch our servers.
  stripeCustomerId             String?      @unique
  defaultStripePaymentMethodId String?
  stripePaymentMethodBrand     String? // "visa" | "mastercard" | ... cached for display
  stripePaymentMethodLast4     String? // last-4 cached for display (not PAN)
  stripePaymentMethodExpMonth  Int?
  stripePaymentMethodExpYear   Int?
  // Legacy migration fields.
  secondaryPhone               String?
  legacyReferralSource         String?
  // S3 key for a persisted signature image captured during registration or
  // migrated from the legacy system. Distinct from per-booking signatures
  // stored on Booking/Inspection models.
  signatureImage               String?
  // Timestamp the customer completed the self-service onboarding wizard
  // (profile basics + identity docs + four signed consent PDFs). NULL
  // forces them through /onboarding on next sign-in.
  onboardedAt                  DateTime?    @db.Timestamptz
  // Joint version key captured at completion:
  // `${TERMS}|${PRIVACY}|${CANCELLATION}|${MARKETING}`. Drives per-doc
  // re-consent when any one constant bumps without forcing a full
  // re-onboard.
  onboardingVersion            String?
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([riskRating])
  @@index([loyaltyTier])
  @@index([referralCode])
  @@index([stripeCustomerId])
  @@index([onboardedAt])
}

model StaffProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  employeeId            String   @unique
  position              String?
  certifications        String[]
  canPerformMaintenance Boolean  @default(false)
  canPerformInspections Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// NextAuth tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id             String   @id @default(cuid())
  sessionToken   String   @unique
  userId         String
  expires        DateTime
  // Admin impersonation: when an admin "views as" another user, the
  // resulting session carries the admin's real user id here. auth()
  // surfaces this so the UI can show a persistent banner and the audit
  // middleware can tag every mutation with it. Sessions where this is
  // null are regular (non-impersonation) sessions.
  impersonatorId String?
  impersonator   User?    @relation("SessionImpersonator", fields: [impersonatorId], references: [id], onDelete: SetNull)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([impersonatorId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================================
// VEHICLES / FLEET
// ============================================================================

model VehicleCategory {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  engineCapacity  Int // cc
  licenceRequired String // e.g. "RE", "R", "Car"
  minAge          Int      @default(18)
  displayOrder    Int      @default(0)
  baseDailyRate   Decimal  @db.Decimal(10, 2)
  baseWeeklyRate  Decimal  @db.Decimal(10, 2)
  baseMonthlyRate Decimal  @db.Decimal(10, 2)
  bondAmount      Decimal  @default(0) @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  images          String[]

  // Phase A1 — per-category online-payment strategy. Controls how much the
  // customer is charged during the booking wizard versus at pickup. The
  // bond is always authorised online regardless of the strategy.
  onlinePaymentStrategy OnlinePaymentStrategy @default(FULL)
  // Used only when onlinePaymentStrategy = FLAT (booking fee in AUD,
  // GST-inclusive to match the displayed total).
  bookingFeeFlat        Decimal?              @db.Decimal(10, 2)
  // Used only when onlinePaymentStrategy = PERCENT (0-100).
  bookingFeePercent     Decimal?              @db.Decimal(5, 2)

  // Phase A2 — progressive billing for long-term hires. A booking whose
  // durationDays >= longTermMinDays (and longTermMinDays is not null) gets
  // a BookingBillingPlan created alongside it; the first period + bond are
  // charged online, then the recurring charges are driven by the
  // booking-billing job.
  longTermMinDays          Int?             @default(14)
  longTermDefaultFrequency BillingFrequency @default(WEEKLY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles      Vehicle[]
  vehicleModels VehicleModel[]
  pricingRules  PricingRule[]
  pricingTiers  PricingTier[]
  packages      Package[]
  bookings      Booking[]
  reviews       Review[]

  @@index([isActive])
}

model Vehicle {
  id                    String           @id @default(cuid())
  internalCode          String           @unique
  rego                  String
  regoState             String
  regoExpiry            DateTime?        @db.Date
  vin                   String?          @unique
  engineNumber          String?
  make                  String
  model                 String
  year                  Int
  colour                String
  categoryId            String
  depotId               String
  status                VehicleStatus    @default(AVAILABLE)
  condition             VehicleCondition @default(GOOD)
  currentOdometerKm     Int              @default(0)
  fuelType              String           @default("Petrol")
  purchaseDate          DateTime?        @db.Date
  purchasePrice         Decimal?         @db.Decimal(12, 2)
  depreciationMethod    String?
  depreciationRate      Decimal?         @db.Decimal(5, 2)
  currentBookValue      Decimal?         @db.Decimal(12, 2)
  insurancePolicyNumber String?
  insuranceExpiry       DateTime?        @db.Date
  ctpExpiry             DateTime?        @db.Date
  lastServiceDate       DateTime?        @db.Date
  lastServiceKm         Int?
  nextServiceDueKm      Int?
  nextServiceDueDate    DateTime?        @db.Date
  notes                 String?
  gpsTrackerId          String?
  ownerId               String?
  warrantyExpiry        DateTime?        @db.Date
  supplierName          String?
  supplierContact       String?
  financeType           String? // CASH | LOAN | LEASE | CHATTEL_MORTGAGE
  financeProvider       String?
  financeRef            String?
  modelId               String?
  isActive              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deletedAt             DateTime?

  category             VehicleCategory        @relation(fields: [categoryId], references: [id])
  catalogueModel       VehicleModel?          @relation(fields: [modelId], references: [id], onDelete: SetNull)
  depot                Depot                  @relation(fields: [depotId], references: [id])
  owner                VehicleOwner?          @relation(fields: [ownerId], references: [id])
  images               VehicleImage[]
  documents            VehicleDocument[]
  statusLog            VehicleStatusLog[]
  bookings             Booking[]
  inspections          Inspection[]
  workOrders           MaintenanceWorkOrder[]
  maintenanceSchedules MaintenanceSchedule[]
  incidents            Incident[]
  telemetry            VehicleTelemetry[]
  infringements        Infringement[]
  transfers            VehicleTransfer[]
  // Mid-rental swap history: times this vehicle was swapped off / onto a booking.
  outgoingSwaps        BookingSwap[]          @relation("BookingSwapOutgoingVehicle")
  incomingSwaps        BookingSwap[]          @relation("BookingSwapIncomingVehicle")
  // Optional per-vehicle pricing overrides. When set these take precedence
  // over the VehicleModel defaults (e.g. a hail-damaged unit discounted, or
  // a premium colourway up-priced). Leave null to inherit from the model.
  baseRateOverride        Decimal?         @db.Decimal(10, 2)
  basePeriodHoursOverride BasePeriodHours?

  // Per-vehicle override of the category-level pricing tier ladder.
  pricingTiers         PricingTier[]

  @@unique([rego, regoState])
  @@index([status])
  @@index([depotId])
  @@index([categoryId])
  @@index([ownerId])
  @@index([modelId])
  @@index([depotId, status, categoryId])
  @@index([status, nextServiceDueKm])
  @@index([deletedAt])
  @@index([status, deletedAt])
  @@index([depotId, deletedAt])
}

/// Shared spec sheet keyed by make + model + year. Many Vehicle rows map to
/// one VehicleModel row, so specs and authoritative PDFs are stored once per
/// model rather than duplicated per VIN.
model VehicleModel {
  id         String  @id @default(cuid())
  make       String
  model      String
  year       Int
  slug       String  @unique
  categoryId String?

  // Specs populated by the enrichment pipeline. All nullable — a model row
  // can exist without ever having been enriched yet.
  engineCapacityCc      Int?
  enginePowerKw         Decimal? @db.Decimal(5, 2)
  engineTorqueNm        Decimal? @db.Decimal(5, 2)
  dryWeightKg           Decimal? @db.Decimal(6, 2)
  fuelTankLitres        Decimal? @db.Decimal(4, 2)
  fuelType              String?
  topSpeedKmh           Int?
  seatHeightMm          Int?
  tyreFront             String?
  tyreRear              String?
  serviceIntervalKm     Int?
  serviceIntervalMonths Int?

  // Provenance
  specsSourceUrl      String?
  specsSourceName     String?
  specsFetchedAt      DateTime?
  specsConfidence     SpecConfidence @default(UNVERIFIED)
  lastEnrichmentError String?

  // Public fleet browsing
  useCases     FleetUseCase[] @default([])
  tagline      String?
  heroImageKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // xpertmoto.com.au-style per-model default rate. Lives at the model level
  // so every Vehicle of (make, model, year) inherits the same rate unless
  // its own override (`baseRateOverride`) is set.
  baseRate        Decimal?         @db.Decimal(10, 2)
  basePeriodHours BasePeriodHours? @default(H24)

  category     VehicleCategory?       @relation(fields: [categoryId], references: [id])
  vehicles     Vehicle[]
  documents    VehicleModelDocument[]
  // Per-model pricing tier ladder — sits between the category ladder and
  // any per-vehicle override in `resolvePricingTiers()`.
  pricingTiers PricingTier[]

  @@unique([make, model, year])
  @@index([categoryId])
  @@index([specsConfidence])
}

/// Manufacturer-sourced document (owner's manual, service schedule, parts
/// catalogue) for a VehicleModel. Always sourced from an allowlisted domain
/// so `sourceDomain` doubles as the "100% confident" proof.
model VehicleModelDocument {
  id           String                   @id @default(cuid())
  modelId      String
  type         VehicleModelDocumentType
  title        String
  fileUrl      String
  storageKey   String?
  sourceUrl    String
  sourceDomain String
  sizeBytes    Int?
  pageCount    Int?
  language     String                   @default("en-AU")
  sha256       String?
  fetchedAt    DateTime                 @default(now())
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  model VehicleModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, type, sha256])
  @@index([modelId])
}

enum SpecConfidence {
  OFFICIAL_MANUFACTURER
  REPUTABLE_SECONDARY
  UNVERIFIED
}

enum VehicleModelDocumentType {
  OWNERS_MANUAL
  SERVICE_SCHEDULE
  PARTS_CATALOGUE
  WIRING_DIAGRAM
  BROCHURE
}

enum FleetUseCase {
  ADVENTURE
  COMMUTING
  PRACTICE
  DELIVERY
  SPORT_CRUISER
  LEARNER_APPROVED
}

model VehicleImage {
