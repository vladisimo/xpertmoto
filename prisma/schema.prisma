  vehicleId            String
  bookingId            String?
  type                 InspectionType
  inspectorId          String
  depotId              String
  dateTime             DateTime          @default(now()) @db.Timestamptz
  odometerKm           Int
  fuelLevel            Int // 0-100
  overallCondition     VehicleCondition
  bodyDamageMap        Json              @default("{}")
  tyreFrontDepth       Decimal?          @db.Decimal(4, 2)
  tyreRearDepth        Decimal?          @db.Decimal(4, 2)
  tyreFrontPressure    Int?
  tyreRearPressure     Int?
  brakeCondition       VehicleCondition?
  lightsWorking        Boolean           @default(true)
  hornWorking          Boolean           @default(true)
  mirrorsCondition     VehicleCondition?
  indicatorsWorking    Boolean           @default(true)
  engineRunning        Boolean           @default(true)
  batteryCondition     VehicleCondition?
  helmetCondition      VehicleCondition?
  lockProvided         Boolean           @default(false)
  notes                String?
  customerSignatureUrl String?
  staffSignatureUrl    String?
  customerAckedAt      DateTime?         @db.Timestamptz
