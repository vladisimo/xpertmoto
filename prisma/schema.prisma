  url          String
  caption      String?
  isPrimary    Boolean @default(false)
  displayOrder Int     @default(0)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model VehicleDocument {
  id                    String              @id @default(cuid())
  vehicleId             String
  type                  VehicleDocumentType
  fileUrl               String
  thumbnailUrl          String?
  expiryDate            DateTime?           @db.Date
  issueDate             DateTime?           @db.Date
  cost                  Decimal?            @db.Decimal(10, 2)
  referenceNumber       String?
  uploadedById          String?
  relatedWorkOrderId    String?
  relatedInfringementId String?
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?

  vehicle             Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  uploadedBy          User?                 @relation("UploadedVehicleDocuments", fields: [uploadedById], references: [id], onDelete: SetNull)
  relatedWorkOrder    MaintenanceWorkOrder? @relation("WorkOrderDocuments", fields: [relatedWorkOrderId], references: [id], onDelete: SetNull)
  relatedInfringement Infringement?         @relation("InfringementDocuments", fields: [relatedInfringementId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([expiryDate])
  @@index([relatedWorkOrderId])
  @@index([relatedInfringementId])
  @@index([vehicleId, createdAt])
  @@index([deletedAt])
}

model CustomerDocument {
  id           String               @id @default(cuid())
  customerId   String
  type         CustomerDocumentType
  fileUrl      String
  label        String?
  expiryDate   DateTime?            @db.Date
  uploadedById String?
  notes        String?
  // Structured OCR / detection results. Written by
  // staffCustomer.detectDocument after running Claude vision on the file.
  // Shape is not enforced at the DB layer; see DetectedLicenceMetadata in
  // src/server/services/document-extract.ts.
  metadata     Json?
  createdAt    DateTime             @default(now())
