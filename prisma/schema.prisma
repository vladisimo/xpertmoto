  @@index([customerId])
  @@index([type])
  @@index([expiryDate])
  // Powers applyLatestDocumentToProfile: "newest row per (customer, type)"
  // lookup becomes a single B-tree range scan.
  @@index([customerId, type, createdAt(sort: Desc)])
}

model VehicleStatusLog {
