/// Insurance claim / damage evidence. MUST NOT be hard-deleted — claims
/// may be revisited years later.
model Incident {
  id                   String           @id @default(cuid())
  incidentNumber       String           @unique
  vehicleId            String
  bookingId            String?
  customerId           String?
  type                 IncidentType
  severity             IncidentSeverity
  status               IncidentStatus   @default(REPORTED)
  dateTime             DateTime         @db.Timestamptz
  location             String?
  description          String
  reportedById         String?
  assignedToId         String?
  customerNotifiedAt   DateTime?        @db.Timestamptz
  policeReportNumber   String?
  insuranceClaimNumber String?
  estimatedDamageCost  Decimal?         @db.Decimal(10, 2)
  actualDamageCost     Decimal?         @db.Decimal(10, 2)
  customerLiable       Boolean          @default(false)
  customerChargeAmount Decimal?         @db.Decimal(10, 2)
  thirdPartyInvolved   Boolean          @default(false)
  thirdPartyDetails    Json?
  resolution           String?
  resolvedAt           DateTime?        @db.Timestamptz
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?

  vehicle        Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  booking        Booking?           @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  reportedBy     User?              @relation("IncidentReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  assignedTo     User?              @relation("IncidentAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  photos         IncidentPhoto[]
  documents      IncidentDocument[]
  notes          IncidentNote[]
  supportTickets SupportTicket[]
  bookingSwap    BookingSwap?

  @@index([vehicleId, createdAt(sort: Desc)])
