enum ServiceDispatchStatus {
  REQUESTED
  ASSIGNED
  EN_ROUTE
  COMPLETED
  CANCELLED
}

model RentalZone {
  id                     String   @id @default(cuid())
  bookingId              String   @unique
  centerLat              Float
  centerLng              Float
  radiusKm               Float    @default(200)
  polygon                Json?
