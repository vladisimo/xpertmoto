  @@unique([subscriptionId, periodStart])
}

model BusinessAccount {
  id            String   @id @default(cuid())
  name          String
  abn           String?
  contactUserId String?
  billingEmail  String?
  addressLine1  String?
  suburb        String?
  state         String?
  postcode      String?
  creditLimit   Decimal  @default(0) @db.Decimal(12, 2)
