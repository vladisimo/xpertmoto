/// Why this inspection was performed. Lets downstream queries distinguish a
/// regular check-in/out from inspections captured during a mid-rental vehicle
/// swap, which otherwise share type=POST_HIRE / PRE_HIRE semantics.
enum InspectionPurpose {
  CHECK_OUT
  CHECK_IN
  SWAP_OUT
  SWAP_IN
  ROUTINE
  INCIDENT
}

/// Financial and operational reason for a mid-rental vehicle swap. Drives
/// pricing (customer pays, is refunded, or no change) and whether a work
/// order / incident must be lodged at commit time.
enum SwapReason {
  UPGRADE
  DOWNGRADE
  LATERAL
  MECHANICAL_FAULT
  ACCIDENT_DAMAGE
  OPERATIONAL
}

/// Reporting channel through which the swap need was raised. Audit-only;
/// does not affect pricing. A customer phoning tech support to report a
/// fault produces (reason=MECHANICAL_FAULT, origin=CUSTOMER_PHONE_SUPPORT).
