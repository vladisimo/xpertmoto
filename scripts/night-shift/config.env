# ── XPERT Moto night-shift configuration (sourced by every night script) ──
REPO=/home/vlad/scootering
NIGHT=/home/vlad/xpertmoto-night
NIGHT_BIN=/home/vlad/scootering/scripts/night-shift
SETTINGS_FILE=/home/vlad/scootering/scripts/night-shift/night-settings.json
GITHUB_REPO=vladisimo/xpertmoto

# Sequential task budget
NIGHT_MAX_TASKS=3
SESSION_TIMEOUT=2700          # 45m build session (per-task override: timeout_minutes)
REPAIR_TIMEOUT=1200           # 20m attempt-2 repair session
CRITIC_TIMEOUT=720            # 12m read-only self-review session
MAX_ATTEMPTS=2                # 1 build + 1 repair

# Window discipline (local time; only enforced for timer-launched runs —
# nightctl run/dry-run set NIGHT_MANUAL=1 which skips the wall-clock cutoffs)
LAST_TASK_START="03:30"       # don't pick a new task after this
SOFT_DEADLINE="04:45"         # don't pick a task that can't fit before this
MIN_TASK_BUDGET_SECONDS=4500  # 75m: session + gates + critic + ship

# Models. MUST stay explicit on every claude invocation: the user-level
# ~/.claude/settings.json pins claude-fable-5[1m] + effortLevel xhigh, which a
# bare headless session would silently inherit.
MODEL_BUILD=opus
MODEL_CHORE=sonnet
MODEL_CRITIC=sonnet

# Gates
MAX_DIFF_LINES=1500           # scope-creep tripwire (per-task override: max_lines)
RATELIMIT_BACKOFF_SECONDS=900 # one patient retry, then surrender the task
RATELIMIT_NIGHT_LIMIT=2       # events across the night before we stop picking tasks

# DoD step timeouts (seconds) — calibrated Night 0; keep headroom over measured
DOD_TSC_TIMEOUT=420
DOD_LINT_TIMEOUT=420
DOD_VITEST_TIMEOUT=1200
DOD_BUILD_TIMEOUT=1500
DOD_E2E_TIMEOUT=1800

# Preflight
MIN_DISK_GB=15

# Optional push-notification webhook (curl -d "<text>" $NIGHT_NTFY_URL)
NIGHT_NTFY_URL=
