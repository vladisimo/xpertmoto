# connection_limit caps how many connections a single app instance opens
# against Postgres. With app + worker + migrate each holding ~10, two
# replicas already saturate a small Postgres. pool_timeout is how long a
# request waits for a free connection before surfacing a P2024. In front
# of pgbouncer, set connection_limit=1 and pgbouncer_pool=<pool name>.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xpertmoto?connection_limit=10&pool_timeout=20

# NextAuth
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# OAuth providers — optional. Each provider only registers when ALL its
# required env vars are set, so local dev works without any of these. OAuth
# is customer-only; staff / admin must sign in with email + password + 2FA
# (enforced server-side in the signIn callback).

# Google — https://console.cloud.google.com/apis/credentials
# Callback: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub — https://github.com/settings/developers
# Callback: <AUTH_URL>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Microsoft Entra ID — covers Outlook/Hotmail/Live/MSN (personal MSA) AND
# work/school accounts. App registration supported-account-types must be
# "multitenant + personal Microsoft accounts" to match TENANT_ID=common.
# Callback: <AUTH_URL>/api/auth/callback/microsoft-entra-id
#
# TENANT_ID options:
#   common         — work/school (any tenant) + personal MSA  [default]
#   organizations  — work/school only
#   consumers      — personal MSA only
#   <tenant-guid>  — one specific organisation only
#
# IMPORTANT: auto-linking to an existing account requires the xms_edov
# optional claim on the ID token (domain-owner-verified). Enable it under
# App registration → Token configuration → Add optional claim → ID →
# xms_edov. Personal MSA accounts never emit xms_edov, so those users
# fall through to the magic-link flow — this is intentional (see
# src/lib/oauth-verification.ts).
AUTH_MICROSOFT_ID=
AUTH_MICROSOFT_SECRET=
AUTH_MICROSOFT_TENANT_ID=common

# Apple — requires an Apple Developer account. PRIVATE_KEY is the PEM
# contents of the .p8 file; escape newlines as \n. Apple does NOT support
# localhost redirects, so test against a public HTTPS URL.
# Callback: <AUTH_URL>/api/auth/callback/apple
AUTH_APPLE_ID=
AUTH_APPLE_TEAM_ID=
AUTH_APPLE_KEY_ID=
AUTH_APPLE_PRIVATE_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Redis (optional in dev)
REDIS_URL=redis://localhost:6379

# Email — prefers Resend when RESEND_API_KEY is set, falls back to SMTP,
# and finally logs to the console in dev. Production boot fails if neither
# RESEND_API_KEY nor SMTP_HOST is set (see src/lib/env.ts).
# For a real SMTP provider on port 587 leave SMTP_SECURE=false — nodemailer
# upgrades the connection via STARTTLS automatically. Only set secure=true
# for port 465 (implicit TLS).
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Set to false to skip TLS cert verification — only for dev against servers
# with self-signed or private-CA certificates. Leave unset in production.
SMTP_TLS_REJECT_UNAUTHORIZED=
EMAIL_FROM=no-reply@xpertmoto.com.au

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Storage (S3 / MinIO). For MinIO local dev set S3_FORCE_PATH_STYLE=true.
# When the access key is blank, uploads fall back to ./public/uploads so
# the app still runs without object storage.
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-2
S3_BUCKET=xpertmoto
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/xpertmoto

# Google Places API — powers the public reviews showcase above the footer.
# Server-side only (no NEXT_PUBLIC_). When unset the showcase falls back to
# a small seeded review list, so local dev works without a key. In prod set
# both and enable "Places API (New)" on the key.
#   Resolve your Place ID via https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_PLACE_ID=

# Maps — Public-facing depot maps use the Google Maps Embed API
# (free, unlimited loads, no billing required). Restrict the key to
# HTTP referrers for the production domain in Google Cloud Console.
# Embed API only — separate from GOOGLE_MAPS_API_KEY (Places, server-side).
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Maps — MapLibre GL JS still renders the back-office depot map. Default
# uses OpenFreeMap's community-hosted OSM vector tiles (no key, free).
# Alternatives: .../styles/bright, positron, dark. Swap to MapTiler /
# Stadia / Mapbox for a paid tier with stronger SLAs.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Legacy Mapbox env retained for any components still referencing it during
# the MapLibre migration; safe to delete once nothing reads it.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Sentry — leave unset in local dev to disable. SENTRY_DSN enables server +
# edge reporting, NEXT_PUBLIC_SENTRY_DSN enables browser reporting.
# SENTRY_ORG/PROJECT/AUTH_TOKEN are only needed in CI for source-map upload.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Logging — set to "debug" for verbose pino output locally.
LOG_LEVEL=info

# PostHog product analytics. Both keys are optional — when unset the admin
# Integrations page surfaces them as "not configured" and no events are sent.
# POSTHOG_KEY is the server-side key; NEXT_PUBLIC_POSTHOG_KEY is the browser
# key. POSTHOG_HOST defaults to https://us.i.posthog.com.
POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_HOST=

# Prisma slow-query threshold. Queries that take longer than this are logged
# via Pino at warn and (if SENTRY_DSN is set) reported as a Sentry message.
# Unset in prod to disable; dev auto-enables without this var.
SLOW_QUERY_MS=500

# E-Toll credential encryption key — generate with: openssl rand -base64 32
ETOLL_ENC_KEY=

# Live-visitor analytics — IP hashing salt (required in prod). Generate with:
# openssl rand -base64 32. Raw IPs are never stored; only SHA-256(ip + salt)
# is persisted on VisitorSession, with a 30-day retention.
IP_HASH_SALT=
# Path to the bundled MaxMind GeoLite2-City.mmdb. Unset disables geo lookup.
# Download: https://www.maxmind.com/en/accounts/current/geoip/downloads then
# drop GeoLite2-City.mmdb into ./data/ (gitignored).
MAXMIND_DB_PATH=./data/GeoLite2-City.mmdb

# Support chatbot feature. Whole feature is gated — if SUPPORT_ENABLED=false
# the widget disappears, /staff/support + /admin/support 404, and the tRPC
# router throws FORBIDDEN. Safe to ship dark.
SUPPORT_ENABLED=true
# Chat AI path toggle. Forced off when no provider credential is set below.
SUPPORT_AI_ENABLED=true
# "anthropic" or "openrouter". Auto-detects from whichever key is set.
SUPPORT_AI_PROVIDER=openrouter
# Direct Anthropic API key. Leave blank to use OpenRouter.
ANTHROPIC_API_KEY=
# OpenRouter key (unified gateway for many models).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://xpertmoto.com.au
OPENROUTER_APP_TITLE=XPERT Moto Support
# Model id. Anthropic: claude-haiku-4-5-20251001 · OpenRouter: anthropic/claude-haiku-4.5
SUPPORT_AI_MODEL=
# Show 1–5 star CSAT prompt after a ticket resolves.
SUPPORT_FEEDBACK_ENABLED=true
# Soft daily AI cost cap (AUD). When exceeded the chat endpoint returns
# a graceful fallback and forces the user into structured forms.
SUPPORT_COST_CAP_AUD_DAILY=25


#   Admin:    admin@xpertmoto.com.au / admin1234
#   Manager:  manager.gold-coast@xpertmoto.com.au / staff1234
#   Staff:    staff.gold-coast@xpertmoto.com.au / staff1234
#   Customer: sarah.smith@example.com / customer1234